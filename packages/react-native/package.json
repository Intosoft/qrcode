    },
    "devDependencies": {
        "@intosoft/qrcode": "workspace:*",
        "@types/react": "^18.0.0",
        "@types/react-native": "^0.72.0",
        "react": "^18.0.0",
        "react-native": "^0.72.0",
        "react-native-svg": "^13.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0"
