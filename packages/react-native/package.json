{
    "name": "@intosoft/qrcode-react-native",
    "version": "1.0.0",
    "description": "React Native helper for @intosoft/qrcode with SVG rendering and native integration",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "react-native": "index.tsx",
