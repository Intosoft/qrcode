{
    "name": "@intosoft/qrcode",
    "version": "0.1.4",
    "description": "The best tool for QR Code generation in JavaScript (React, React Native, Node.js, VueJS, Angular, JQuery, VanillaJS)",
    "main": "./dist/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/index.d.ts",
    "homepage": "https://github.com/Intosoft/qrcode",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Intosoft/qrcode.git"
    },
    "scripts": {
        "build": "rimraf ./dist && tsup",
        "build:full": "rimraf ./dist && tsup && yarn build:packages",
        "build:web": "rimraf ./dist && tsup",
        "build:packages": "yarn workspaces foreach --parallel run build",
        "build:native": "./scripts/build-native.sh",
        "build:rn": "cd ./packages/react-native && yarn && yarn build",
        "release": "./scripts/release.sh",
        "verify": "./scripts/verify-native.sh",
        "test": "yarn tsc && yarn lint",
        "test:packages": "yarn workspaces foreach run type-check",
        "unused-exports": "ts-unused-exports ./tsconfig.json --excludePathsFromReport='index.ts;/dist;/examples;src/generateContent.ts;src/config.ts;tsup.config.ts'",
        "tsc": "tsc --noEmit",
        "lint": "yarn format && yarn eslint && yarn unused-exports",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "eslint": "eslint .",
        "lint:fix": "yarn format:fix && yarn eslint --fix",
        "audit:fix": "yarn audit --fix",
        "prepare": "yarn build",
        "prepublishOnly": "yarn test && yarn test:packages"
    },
    "author": {
        "name": "Sakul Budhathoki",
        "email": "sakulbudhathoki977@gmail.com"
    },
    "license": "MIT",
    "dependencies": {
        "qrcode": "github:sakul-budhathoki/node-qrcode#feat/core"
    },
    "devDependencies": {
        "@types/qrcode": "^1.5.5",
        "@types/react": "^19.1.8",
        "@types/react-native": "^0.73.0",
        "@typescript-eslint/eslint-plugin": "^7.1.1",
        "@typescript-eslint/parser": "^7.1.1",
        "eslint": "^8.57.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-prettier": "^5.1.3",
        "prettier": "^3.2.5",
        "rimraf": "^5.0.5",
        "ts-unused-exports": "^10.0.1",
        "tsup": "^8.0.2",
        "tsx": "^4.7.1",
        "typescript": "^5.3.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "QR code generator",
        "QR code customization",
        "JavaScript QR code tool",
        "React QR code",
        "React Native QR code",
        "Node.js QR code",
        "VueJS QR code",
        "Angular QR code",
        "VanillaJS QR code",
        "iOS Swift QR code",
        "Android Kotlin QR code",
        "Native QR code",
        "QR code design",
        "Custom QR code shapes",
        "QR code with logo",
        "QR code color customization",
        "High-resolution QR codes",
        "Print quality QR codes",
        "Open-source QR code tool",
        "QR code branding",
        "Gradient QR codes",
        "Error correction QR codes",
        "QR code integration"
    ],
    "workspaces": [
        "packages/*"
    ],
    "private": true
}
